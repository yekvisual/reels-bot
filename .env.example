# Bu dosyayı .env olarak kopyalayın ve doldurun (.env asla GitHub'a yüklenmez)

# Meta Developer panelinden aldığınız uzun ömürlü Instagram token'ı
IG_ACCESS_TOKEN=

# instagram = Instagram Login (önerilen, Facebook sayfası gerekmez)
# facebook  = Facebook Login (IG hesabı bir Facebook sayfasına bağlıysa)
IG_API=instagram

# Boş bırakılırsa otomatik bulunur (IG_API=facebook ise zorunlu)
IG_USER_ID=

# url = Instagram videoyu herkese açık bir adresten çeker
# resumable = video doğrudan bilgisayardan yüklenir (yalnızca IG_API=facebook)
# UPLOAD_MODE=url

# UPLOAD_MODE=url iken videoların herkese açık adresi (sonunda / olsun)
# Örn: https://raw.githubusercontent.com/KULLANICI/REPO/main/
VIDEO_BASE_URL=

# Videonun yanında .txt açıklama dosyası yoksa kullanılacak açıklama
DEFAULT_CAPTION=

# Reels ana profil ızgarasında da görünsün mü
SHARE_TO_FEED=true
